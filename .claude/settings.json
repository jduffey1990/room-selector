{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh pr create *)",
      "Bash(gh repo *)",
      "Read(./seed/serviceAccountKey.json)",
      "Edit(./seed/serviceAccountKey.json)",
      "Edit(./seed/v1-archive/**)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(firebase deploy *)",
      "Bash(firebase functions:*)",
      "Bash(firebase hosting:*)",
      "Bash(firebase emulators:*)",
      "Bash(firebase firestore:*)",
      "Bash(firebase --version)",
      "Bash(curl *)",
      "Bash(dig *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(sed *)",
      "Bash(python3 *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  }
}
